# Copiar a .env (en esta misma carpeta) y rellenar con tus propios valores.
# Nunca versionar el .env real — ya está en .gitignore de la raíz del repo.

# Puerto local en el que se expone el proxy (opcional, por defecto 4000).
LITELLM_PORT=4000

# Clave maestra del proxy (admin) — debe empezar por "sk-". Genera una propia,
# p. ej. con `openssl rand -hex 32`; NUNCA uses el valor de ejemplo de verdad.
LITELLM_MASTER_KEY=sk-CAMBIA-ESTA-CLAVE

# Cifra las credenciales de proveedor que se añadan vía la UI de LiteLLM.
# Aviso: cambiarla después del primer arranque invalida lo ya cifrado en la BD
# — fíjala una vez y no la toques más en este despliegue.
LITELLM_SALT_KEY=CAMBIA-ESTA-CLAVE-TAMBIEN

# Conexión a la Postgres del propio docker-compose.yml (LiteLLM la necesita
# para gestionar virtual keys/presupuestos). No cambies el host "postgres": es
# el nombre del servicio dentro de la red de docker-compose, no un host real.
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm
POSTGRES_PASSWORD=litellm

# API key real del proveedor que sirve el modelo (Anthropic) — referenciada
# desde config.yaml vía "os.environ/ANTHROPIC_API_KEY", nunca en claro ahí.
ANTHROPIC_API_KEY=sk-ant-...
