{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% block title %}doc_organize — Caché: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "cache") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Caché: {{ project.name }}</h1>

<p class="mb-3">
    <a class="text-blue-600 underline text-sm" href="/downloads/projects/{{ project.name | urlencode }}/cache-export.xlsx">
        ⬇ Exportar a Excel
    </a>
</p>

{% if total > 0 or q %}
<form method="get" id="cache-filter-form" class="my-3 flex flex-wrap items-end gap-3">
    <div>
        <label for="cache-search" class="block text-sm font-medium mb-1">Buscar por nombre o carpeta</label>
        <input type="text" id="cache-search" name="q" value="{{ q or '' }}"
               placeholder="Filtra por nombre de archivo o ruta de carpeta…"
               class="border border-gray-300 rounded px-2 py-1.5 w-full max-w-md">
    </div>
    <div>
        <label for="cache-page-size" class="block text-sm font-medium mb-1">Filas por página</label>
        <select id="cache-page-size" name="page_size" onchange="this.form.requestSubmit()"
                class="border border-gray-300 rounded px-2 py-1.5">
        {% for option in page_size_options %}
            <option value="{{ option }}" {% if option == page_size %}selected{% endif %}>{{ option }}</option>
        {% endfor %}
        </select>
    </div>
    <input type="hidden" name="page" id="cache-page-input" value="1">
    <p class="text-gray-500 text-sm" id="cache-count">
    {% if total == 0 %}
        Sin resultados{% if q %} para «{{ q }}»{% endif %}.
    {% else %}
        Mostrando {{ range_start }}–{{ range_end }} de {{ total }} entradas.
    {% endif %}
    </p>
</form>

{% if entries %}
<div class="overflow-x-auto">
<table class="w-full border-collapse mt-4">
    <thead>
        <tr>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white">Archivo</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white">Carpeta</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-32">Hash</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-24">Estado</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-28">Conversión</th>
    </tr></thead>
    <tbody>
    {% for entry in entries %}
        <tr class="even:bg-gray-50 hover:bg-blue-50">
            <td class="px-2.5 py-1.5 border-b border-gray-300 break-all">{{ entry.file_path | basename | highlight(q) }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 break-all text-gray-600 font-mono text-xs" title="{{ entry.file_path }}">{{ entry.file_path | dirname | highlight(q) }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.sha256_hash[:12] }}…</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.status }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.conversion_status or "—" }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>

{% if total_pages > 1 %}
<nav aria-label="Paginación" class="flex items-center justify-between mt-3 text-sm">
    {% set base_qs = "q=" + (q or "") | urlencode + "&page_size=" + page_size | string %}
    {% if page > 1 %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ page - 1 }}">« Anterior</a>
    {% else %}
    <span class="text-gray-400">« Anterior</span>
    {% endif %}
    <span class="text-gray-600">Página {{ page }} de {{ total_pages }}</span>
    {% if page < total_pages %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ page + 1 }}">Siguiente »</a>
    {% else %}
    <span class="text-gray-400">Siguiente »</span>
    {% endif %}
</nav>
{% endif %}

<p class="mt-3"><a href="#cache-search" class="text-blue-600 underline text-sm">↑ Volver arriba</a></p>
{% endif %}
{% else %}
<p>No hay entradas en caché todavía — ejecuta un
   <a class="text-blue-600 underline" href="/projects/{{ project.name | urlencode }}/scan">escaneo</a>.</p>
{% endif %}

<script>
(function () {
    const searchInput = document.getElementById("cache-search");
    if (!searchInput) return;

    const form = document.getElementById("cache-filter-form");
    const pageInput = document.getElementById("cache-page-input");
    let debounceTimer = null;

    searchInput.addEventListener("input", () => {
        pageInput.value = "1";
        if (debounceTimer) window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => form.requestSubmit(), 400);
    });

    // Tras recargar por una busqueda, recupera el foco y coloca el cursor al final
    // para poder seguir escribiendo sin tener que volver a hacer click en el input.
    if (searchInput.value) {
        searchInput.focus();
        const end = searchInput.value.length;
        searchInput.setSelectionRange(end, end);
    }
})();
</script>
{% endblock %}
