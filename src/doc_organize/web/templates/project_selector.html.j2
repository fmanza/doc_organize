{% extends "base.html.j2" %}
{% block title %}doc_organize — Proyectos{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Proyectos</h1>

<form id="create-form" class="my-4 flex gap-2 flex-wrap">
    <label for="name" class="sr-only">Nombre del proyecto</label>
    <input type="text" id="name" placeholder="Nombre del proyecto" required
           class="border border-gray-300 rounded px-2 py-1.5 flex-1 min-w-[200px]">
    <label for="location" class="sr-only">Ubicación (carpeta padre)</label>
    <input type="text" id="location" placeholder="Ubicación (carpeta padre)" required
           class="border border-gray-300 rounded px-2 py-1.5 flex-1 min-w-[200px]">
    <button type="submit" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Crear proyecto</button>
</form>
<p id="create-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

{% if total > 0 or q %}
<form method="get" id="project-filter-form" class="my-3 flex flex-wrap items-end gap-3">
    <div>
        <label for="project-search" class="block text-sm font-medium mb-1">Buscar por nombre o ubicación</label>
        <input type="text" id="project-search" name="q" value="{{ q or '' }}"
               placeholder="Filtra por nombre de proyecto o ruta…"
               class="border border-gray-300 rounded px-2 py-1.5 w-full max-w-md">
    </div>
    <div>
        <label for="project-page-size" class="block text-sm font-medium mb-1">Filas por página</label>
        <select id="project-page-size" name="page_size" onchange="this.form.requestSubmit()"
                class="border border-gray-300 rounded px-2 py-1.5">
        {% for option in page_size_options %}
            <option value="{{ option }}" {% if option == page_size %}selected{% endif %}>{{ option }}</option>
        {% endfor %}
        </select>
    </div>
    <input type="hidden" name="page" id="project-page-input" value="1">
    <p class="text-gray-500 text-sm" id="project-count">
    {% if total == 0 %}
        Sin resultados{% if q %} para «{{ q }}»{% endif %}.
    {% else %}
        Mostrando {{ range_start }}–{{ range_end }} de {{ total }} entradas.
    {% endif %}
    </p>
</form>

{% if projects %}
<table class="w-full border-collapse mt-4">
    <thead><tr>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Nombre</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Ubicación</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Creado</th>
    </tr></thead>
    <tbody>
    {% for project in projects %}
        <tr>
            <td class="px-2.5 py-1.5 border-b border-gray-300"><a class="text-blue-600 underline" href="/projects/{{ project.name | urlencode }}">{{ project.name | highlight(q) }}</a></td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 text-gray-600 font-mono text-xs">{{ project.root_path | highlight(q) }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300">{{ project.created_at | format_datetime }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{% if total_pages > 1 %}
<nav aria-label="Paginación" class="flex items-center justify-between mt-3 text-sm">
    {% set base_qs = "q=" + (q or "") | urlencode + "&page_size=" + page_size | string %}
    {% if page > 1 %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ page - 1 }}">« Anterior</a>
    {% else %}
    <span class="text-gray-400">« Anterior</span>
    {% endif %}
    <span class="text-gray-600">Página {{ page }} de {{ total_pages }}</span>
    {% if page < total_pages %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ page + 1 }}">Siguiente »</a>
    {% else %}
    <span class="text-gray-400">Siguiente »</span>
    {% endif %}
</nav>
{% endif %}
{% endif %}
{% else %}
<p>No hay proyectos todavía.</p>
{% endif %}

<script>
document.getElementById("create-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = document.getElementById("name").value;
    const base_location = document.getElementById("location").value;
    const response = await fetch("/api/projects", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: name, base_location: base_location }),
    });
    if (response.ok) {
        window.location.reload();
    } else {
        const data = await response.json();
        document.getElementById("create-error").textContent = data.detail || "Error al crear el proyecto.";
    }
});

// --- Búsqueda de proyectos (auto-submit con debounce, igual que la pestaña Caché) ---

(function () {
    const searchInput = document.getElementById("project-search");
    if (!searchInput) return;

    const projectForm = document.getElementById("project-filter-form");
    const pageInput = document.getElementById("project-page-input");
    let debounceTimer = null;

    searchInput.addEventListener("input", () => {
        pageInput.value = "1";
        if (debounceTimer) window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => projectForm.requestSubmit(), 400);
    });

    if (searchInput.value) {
        searchInput.focus();
        const end = searchInput.value.length;
        searchInput.setSelectionRange(end, end);
    }
})();
</script>
{% endblock %}
