{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% from "_semaforo_macros.html.j2" import semaforo_html, semaforo_script %}
{% block title %}doc_organize — Contexto: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "context") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Contexto: {{ project.name }}</h1>
<p class="text-sm text-gray-600 mb-4">
    Clasifica los documentos ya convertidos de este proyecto en dominios, los copia a
    <code>{{ context.output_folder_name if context else default_output_folder_name }}/</code> y genera un sitio MkDocs navegable.
</p>

{% if context %}
<p class="text-sm mb-3">
    Carpeta de salida: <code>{{ context.output_folder_name }}/</code>
    — fija mientras exista este contexto; para usar otra, elimínalo primero (abajo).
</p>
{% else %}
<label class="block mb-3 text-sm">
    Carpeta de salida (solo se puede elegir ahora; una vez construido el contexto queda fija):
    <input type="text" id="output-folder-name-input" value="{{ default_output_folder_name }}"
           class="block mt-1 px-2 py-1 border border-gray-300 rounded font-mono text-xs w-64">
</label>
{% endif %}

<label class="flex items-center gap-2 mb-3 text-sm{% if not litellm_configured %} opacity-50 cursor-not-allowed{% endif %}">
    <input type="checkbox" id="ai-classification-toggle"
           {% if context and context.ai_classification_enabled and litellm_configured %}checked{% endif %}
           {% if not litellm_configured %}disabled{% endif %}>
    Clasificación asistida por IA (Sub-fase B) para lo que las reglas dejen sin clasificar.
</label>
{% if litellm_configured %}
<p class="text-sm text-green-700 mb-3">✓ LiteLLM Proxy configurado para clasificación por IA.</p>
{% else %}
<p class="text-sm text-amber-700 mb-3">
    ⚠ LiteLLM Proxy no configurado — la clasificación por IA (Sub-fase B) no funcionará hasta configurarlo
    (<a href="/docs/guides/litellm_proxy_setup/" class="underline">ver guía</a>).
</p>
{% endif %}

<div class="flex items-center gap-2 mb-4">
<button type="button" id="build-context-btn" class="px-3 py-1.5 border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 cursor-pointer">
    {{ "Reconstruir contexto" if context else "Construir contexto" }}
</button>
{% if context %}
<button type="button" id="delete-context-btn" class="px-3 py-1.5 border border-red-300 rounded bg-red-50 text-red-700 hover:bg-red-100 cursor-pointer">
    Eliminar contexto
</button>
{% endif %}
</div>
<p id="build-context-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

{{ semaforo_html("context-semaforo", "context-light-started", "context-light-running", "context-light-completed", "context-semaforo-status-text") }}

<div id="context-build-progress" class="my-3" hidden>
    <p id="context-build-progress-text" class="text-sm text-gray-700 mb-1"></p>
    <progress id="context-build-progress-bar" class="w-full h-2" max="1" value="0"></progress>
</div>

{% if context %}
<div id="delete-context-confirm" hidden class="mb-4 p-3 border border-red-300 rounded bg-red-50 text-sm">
    <p class="mb-2">
        ¿Eliminar el contexto de este proyecto? Se borrará <code>{{ context.output_folder_name }}/</code>,
        el sitio MkDocs generado y la clasificación por dominios. Esta acción no se puede deshacer.
    </p>
    <div class="flex gap-2">
        <button type="button" id="delete-context-confirm-btn" class="px-2 py-1 border border-red-400 rounded bg-red-600 text-white hover:bg-red-700 cursor-pointer text-sm">Sí, eliminar</button>
        <button type="button" id="delete-context-cancel-btn" class="px-2 py-1 border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 cursor-pointer text-sm">Cancelar</button>
    </div>
</div>
{% endif %}

{% if context and not context.reorganized %}
<p class="text-sm text-red-700 mb-3">⚠ La última construcción no terminó de copiar los documentos a <code>{{ context.output_folder_name }}/</code> — reconstruye el contexto.</p>
{% elif context and not context.mkdocs_generated %}
<p class="text-sm text-red-700 mb-3">⚠ La última construcción no terminó de generar el sitio MkDocs — reconstruye el contexto.</p>
{% elif context and not context.mkdocs_site_built %}
<p class="text-sm text-amber-700 mb-3">⚠ <code>mkdocs.yml</code> generado, pero no se pudo construir el sitio navegable (¿está <code>mkdocs</code> instalado? extra <code>doc_organize[docs]</code>) — revisa los logs del servidor.</p>
{% elif context and context.mkdocs_site_built %}
<p class="text-sm text-green-700 mb-3">
    ✓ Sitio de documentación listo —
    <a href="/projects/{{ project.name | urlencode }}/context/site/" target="_blank" rel="noopener" class="underline">ver documentación generada</a>.
</p>
{% endif %}

{% if context and context.taxonomy_manifest_used %}
<p class="text-sm text-green-700 mb-3">
    ✓ Modo manifiesto de taxonomía activo — catálogo de dominios + tipos de material cargado desde <code>taxonomy_manifest.md</code>.
    Cada dominio clasifica también por tipo de material (despliega la fila para verlo por documento).
</p>
{% endif %}

{% if context and context.domains %}
<div class="overflow-x-auto">
<table class="w-full text-sm border-collapse">
    <thead>
        <tr class="text-left text-gray-600 border-b border-gray-300">
            <th class="py-1 pr-2">Dominio</th>
            <th class="py-1 pr-2">Estado</th>
            <th class="py-1 pr-2 text-right">Documentos</th>
        </tr>
    </thead>
    <tbody>
        {% for domain in context.domains %}
        <tr class="border-t border-gray-200">
            <td class="py-1 pr-2">
                {% if context.taxonomy_manifest_used %}
                <button type="button" class="domain-toggle-btn text-gray-500 hover:text-gray-800 cursor-pointer mr-1"
                        data-target="domain-detail-{{ domain.slug }}" aria-expanded="false">▸</button>
                {% endif %}
                {{ domain.name }}
            </td>
            <td class="py-1 pr-2">{{ "Confirmado" if domain.status == "confirmado" else "Borrador" }}</td>
            <td class="py-1 pr-2 text-right">{{ domain.documents | length }}</td>
        </tr>
        {% if context.taxonomy_manifest_used %}
        <tr id="domain-detail-{{ domain.slug }}" class="border-t border-gray-200 bg-gray-50" hidden>
            <td colspan="3" class="py-1 pr-2">
                <table class="w-full text-xs border-collapse">
                    <thead>
                        <tr class="text-left text-gray-500">
                            <th class="py-0.5 pr-2">Documento</th>
                            <th class="py-0.5 pr-2">Tipo de material</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for document in domain.documents %}
                        {% set material_slug = document.material_type or "sin-clasificar" %}
                        <tr class="border-t border-gray-200">
                            <td class="py-0.5 pr-2">{{ document.title }}</td>
                            <td class="py-0.5 pr-2{% if material_slug == 'sin-clasificar' %} text-amber-700{% endif %}">
                                {{ document.material_type_name or material_slug.replace("-", " ").title() }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </td>
        </tr>
        {% endif %}
        {% endfor %}
    </tbody>
</table>
</div>
{% if context.unclassified_documents %}
<p class="text-sm text-amber-700 mt-3">{{ context.unclassified_documents | length }} documento(s) sin clasificar (por debajo del umbral de confianza).</p>
{% endif %}
{% elif context %}
<p class="text-gray-500">No se detectó ningún dominio en el último build.</p>
{% else %}
<p class="text-gray-500">Todavía no se ha construido el contexto de este proyecto.</p>
{% endif %}

<script>
const projectName = {{ project.name | tojson }};
const wsProtocol = window.location.protocol === "https:" ? "wss:" : "ws:";
const wsBaseUrl = wsProtocol + "//" + window.location.host + "/api/projects/" + encodeURIComponent(projectName) + "/context";

const errorEl = document.getElementById("build-context-error");
const buildBtn = document.getElementById("build-context-btn");
const deleteBtn = document.getElementById("delete-context-btn");

function setControlsDisabled(disabled) {
    buildBtn.disabled = disabled;
    if (deleteBtn) deleteBtn.disabled = disabled;
}

// --- Despliega/colapsa la fila de detalle (documentos + tipo de material) de un
// dominio, solo presente en modo manifiesto de taxonomía (botones renderizados
// por el servidor únicamente cuando `context.taxonomy_manifest_used`). ---
document.querySelectorAll(".domain-toggle-btn").forEach((toggleBtn) => {
    toggleBtn.addEventListener("click", () => {
        const detailRow = document.getElementById(toggleBtn.dataset.target);
        const expanding = detailRow.hidden;
        detailRow.hidden = !expanding;
        toggleBtn.textContent = expanding ? "▾" : "▸";
        toggleBtn.setAttribute("aria-expanded", String(expanding));
    });
});

// --- Semáforo (mismo patrón que folder_selector.html.j2/duplicates_resolver.html.j2:
// 3 luces + texto, "error" repinta de rojo la última luz alcanzada en vez de añadir
// una 4ª luz) — compartido entre "Reconstruir/Construir contexto" y "Eliminar
// contexto": solo una de las dos puede estar en curso a la vez (mismo lock de
// operación de proyecto que ya bloquea escaneo/dedup/mover/borrar). Funciones
// generadas por `_semaforo_macros.html.j2::semaforo_script` (AUDIT_CODE, sesión
// 2026-09-10) — `setSemaforo(phase, label)` usa `label` para las sub-fases propias
// de Contexto (Clasificando/Copiando/Generando/Eliminando), que Escanear/Duplicados
// no tienen. ---
{{ semaforo_script(
    lights_var="semaforoLights", text_var="semaforoText", phase_const="PHASE", phase_var="semaforoPhase",
    reset_fn="resetSemaforo", set_fn="setSemaforo",
    started_id="context-light-started", running_id="context-light-running", completed_id="context-light-completed",
    text_id="context-semaforo-status-text",
    started_text="Iniciando…", running_text="En ejecución…", completed_text="Finalizado",
    error_text="Error: la operación se ha interrumpido"
) }}

// --- Barra de progreso numérica, solo para build (delete no tiene bucles reales
// que contar — solo 3 pasos macro, cubiertos ya por el semáforo). ---
const buildProgressContainer = document.getElementById("context-build-progress");
const buildProgressText = document.getElementById("context-build-progress-text");
const buildProgressBar = document.getElementById("context-build-progress-bar");

function resetBuildProgress() {
    buildProgressContainer.hidden = true;
    buildProgressText.textContent = "";
    buildProgressBar.max = 1;
    buildProgressBar.value = 0;
}

function showBuildProgress(total, index, label) {
    if (total <= 0) return;
    buildProgressContainer.hidden = false;
    buildProgressBar.max = total;
    buildProgressBar.value = index;
    buildProgressText.textContent = label + " " + index + "/" + total;
}

buildBtn.addEventListener("click", () => {
    if (buildBtn.disabled) return;
    errorEl.textContent = "";
    resetSemaforo();
    resetBuildProgress();
    setControlsDisabled(true);

    const aiEnabled = document.getElementById("ai-classification-toggle").checked;
    const outputFolderInput = document.getElementById("output-folder-name-input");
    const body = { ai_classification_enabled: aiEnabled };
    if (outputFolderInput) {
        body.output_folder_name = outputFolderInput.value;
    }

    const ws = new WebSocket(wsBaseUrl + "/build");
    let finished = false;

    ws.onopen = () => {
        ws.send(JSON.stringify(body));
    };
    ws.onmessage = (message) => {
        const event = JSON.parse(message.data);
        if (event.event === "started") {
            setSemaforo(PHASE.STARTED);
        } else if (event.event === "ai_classifying_started") {
            setSemaforo(PHASE.RUNNING, "Clasificando con IA…");
        } else if (event.event === "ai_document_classified") {
            setSemaforo(PHASE.RUNNING, "Clasificando con IA…");
            showBuildProgress(event.data.total, event.data.index, "Clasificando");
        } else if (event.event === "reorganize_started") {
            setSemaforo(PHASE.RUNNING, "Copiando documentos…");
            showBuildProgress(event.data.total, 0, "Copiando");
        } else if (event.event === "document_copied") {
            setSemaforo(PHASE.RUNNING, "Copiando documentos…");
            showBuildProgress(event.data.total, event.data.index, "Copiando");
        } else if (event.event === "mkdocs_started") {
            setSemaforo(PHASE.RUNNING, "Generando sitio MkDocs…");
        } else if (event.event === "completed") {
            finished = true;
            setSemaforo(PHASE.COMPLETED, "Contexto construido");
            ws.close();
            window.location.reload();
        }
    };
    ws.onerror = () => {
        errorEl.textContent = "Error de conexión durante la construcción del contexto.";
        setSemaforo(PHASE.ERROR);
        setControlsDisabled(false);
    };
    ws.onclose = (closeEvent) => {
        if (!finished) {
            setSemaforo(PHASE.ERROR);
            errorEl.textContent = closeEvent.reason || "No se pudo construir el contexto.";
            setControlsDisabled(false);
        }
    };
});

if (deleteBtn) {
    const confirmPanel = document.getElementById("delete-context-confirm");
    deleteBtn.addEventListener("click", () => {
        confirmPanel.hidden = false;
    });
    document.getElementById("delete-context-cancel-btn").addEventListener("click", () => {
        confirmPanel.hidden = true;
    });
    const deleteConfirmBtn = document.getElementById("delete-context-confirm-btn");
    deleteConfirmBtn.addEventListener("click", () => {
        if (deleteConfirmBtn.disabled) return;
        errorEl.textContent = "";
        confirmPanel.hidden = true;
        resetSemaforo();
        setControlsDisabled(true);
        deleteConfirmBtn.disabled = true;

        const ws = new WebSocket(wsBaseUrl + "/delete");
        let finished = false;

        ws.onopen = () => {
            ws.send(JSON.stringify({ confirm: true }));
        };
        ws.onmessage = (message) => {
            const event = JSON.parse(message.data);
            if (event.event === "started") {
                setSemaforo(PHASE.STARTED);
            } else if (event.event === "output_deleted" || event.event === "site_deleted") {
                setSemaforo(PHASE.RUNNING, "Eliminando contexto…");
            } else if (event.event === "completed") {
                finished = true;
                setSemaforo(PHASE.COMPLETED, "Contexto eliminado");
                ws.close();
                window.location.reload();
            }
        };
        ws.onerror = () => {
            errorEl.textContent = "Error de conexión durante la eliminación del contexto.";
            setSemaforo(PHASE.ERROR);
            setControlsDisabled(false);
            deleteConfirmBtn.disabled = false;
        };
        ws.onclose = (closeEvent) => {
            if (!finished) {
                setSemaforo(PHASE.ERROR);
                errorEl.textContent = closeEvent.reason || "No se pudo eliminar el contexto.";
                setControlsDisabled(false);
                deleteConfirmBtn.disabled = false;
            }
        };
    });
}
</script>
{% endblock content %}
