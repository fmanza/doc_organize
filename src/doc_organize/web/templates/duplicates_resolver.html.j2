{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% block title %}doc_organize — Duplicados: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "duplicates") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Duplicados: {{ project.name }}</h1>

{% if groups %}
<form id="resolve-form" class="my-4">
    {% for item in groups %}
    <fieldset class="border border-gray-300 rounded p-3 mb-3">
        <legend class="px-1 font-medium">Grupo {{ loop.index }} ({{ item.group.reason.value }})</legend>
        {% for doc in item.members %}
        <label class="block py-1">
            <input type="radio" name="group-{{ item.key }}" value="{{ doc.full_path }}"
                   {% if doc.full_path == item.group.canonical_doc.full_path %}checked{% endif %}>
            {{ doc.full_path }} ({{ doc.size_bytes }} bytes)
        </label>
        {% endfor %}
    </fieldset>
    {% endfor %}
    <button type="submit" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Resolver duplicados</button>
</form>
<p id="resolve-result" class="mt-2"></p>
{% else %}
<p>No se detectaron duplicados.</p>
{% endif %}

<script>
const projectName = {{ project.name | tojson }};
const form = document.getElementById("resolve-form");
if (form) {
    form.addEventListener("submit", async (submitEvent) => {
        submitEvent.preventDefault();
        const resolutions = {};
        const formData = new FormData(form);
        for (const [fieldName, value] of formData.entries()) {
            resolutions[fieldName.replace("group-", "")] = value;
        }
        const response = await fetch(
            "/api/projects/" + encodeURIComponent(projectName) + "/duplicates/resolve",
            {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ resolutions: resolutions }),
            }
        );
        const data = await response.json();
        const resultEl = document.getElementById("resolve-result");
        if (response.ok) {
            resultEl.textContent = "Movidos: " + data.moved + " (grupos resueltos: " + data.groups_resolved + ")";
        } else {
            resultEl.textContent = data.detail || "Error al resolver duplicados.";
        }
    });
}
</script>
{% endblock %}
