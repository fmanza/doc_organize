{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% block title %}doc_organize — Duplicados: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "duplicates") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Duplicados: {{ project.name }}</h1>

<div role="tablist" class="flex gap-1 border-b border-gray-300 mb-4">
    <button type="button" id="tab-btn-resolve" role="tab" aria-selected="{{ 'true' if active_tab != 'history' else 'false' }}" aria-controls="tab-panel-resolve"
            class="page-tab-btn px-3 py-1.5 border border-b-0 rounded-t cursor-pointer {{ 'bg-white border-gray-300 font-medium' if active_tab != 'history' else 'bg-gray-50 border-transparent text-gray-600 hover:bg-gray-100' }}">Buscar duplicados</button>
    <button type="button" id="tab-btn-history" role="tab" aria-selected="{{ 'true' if active_tab == 'history' else 'false' }}" aria-controls="tab-panel-history"
            class="page-tab-btn px-3 py-1.5 border border-b-0 rounded-t cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 {{ 'bg-white border-gray-300 font-medium' if active_tab == 'history' else 'bg-gray-50 border-transparent text-gray-600 hover:bg-gray-100' }}">Histórico de deduplicaciones</button>
</div>

<div id="tab-panel-resolve" role="tabpanel" aria-labelledby="tab-btn-resolve" {% if active_tab == 'history' %}hidden{% endif %}>

<h2 class="text-lg font-medium mt-2 mb-2">Buscar duplicados</h2>
<p class="text-sm text-gray-600 mb-2">Busca y mueve duplicados en todas las carpetas guardadas del proyecto, aplicando las reglas de negocio actuales (se conserva por defecto el documento más antiguo de cada grupo).</p>
<button type="button" id="deduplicate-btn" {% if not has_saved_folders %}disabled{% endif %} class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50">Buscar duplicados</button>
{% if not has_saved_folders %}
<p class="text-xs text-gray-500 mt-1">Deshabilitado hasta guardar al menos una carpeta (menú {{ project.name }}, Carpetas guardadas).</p>
{% endif %}
<p id="deduplicate-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

<div id="dedup-semaforo" role="status" aria-live="polite" class="flex flex-wrap items-center gap-4 my-3 px-3 py-2 rounded border border-gray-200 bg-gray-50 w-fit">
    <span class="flex items-center gap-1.5">
        <span id="dedup-light-started" class="inline-block w-3.5 h-3.5 rounded-full border bg-gray-300 border-gray-400"></span>
        <span class="text-xs text-gray-600">Inicio</span>
    </span>
    <span class="flex items-center gap-1.5">
        <span id="dedup-light-running" class="inline-block w-3.5 h-3.5 rounded-full border bg-gray-300 border-gray-400"></span>
        <span class="text-xs text-gray-600">Ejecución</span>
    </span>
    <span class="flex items-center gap-1.5">
        <span id="dedup-light-completed" class="inline-block w-3.5 h-3.5 rounded-full border bg-gray-300 border-gray-400"></span>
        <span class="text-xs text-gray-600">Finalización</span>
    </span>
    <span id="dedup-semaforo-status-text" class="text-sm font-medium text-gray-600 ml-2">Sin iniciar</span>
    <span id="dedup-semaforo-duration-text" class="text-sm text-gray-500 ml-2"></span>
</div>

<div id="dedup-group-progress" class="my-3" hidden>
    <p id="dedup-group-progress-text" class="text-sm text-gray-700 mb-1"></p>
    <progress id="dedup-group-progress-bar" class="w-full h-2" max="1" value="0"></progress>
</div>

<div id="resolve-results-container">
<h2 class="text-lg font-medium mt-4 mb-2">Resultado de los duplicados</h2>
{% if groups %}
<form id="resolve-form" class="my-4">
    {% for item in groups %}
    <fieldset class="border border-gray-300 rounded p-3 mb-3">
        <legend class="px-1 font-medium">Grupo {{ loop.index }} ({{ item.group.reason.value }})</legend>
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-gray-600">
                    <th class="w-8 py-1"></th>
                    <th class="py-1 pr-2">Archivo</th>
                    <th class="py-1 pr-2">Carpeta</th>
                    <th class="py-1 pr-2 text-right">Tamaño</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in item.members %}
                {% set is_default = doc.full_path == item.group.canonical_doc.full_path %}
                <tr class="border-t border-gray-200">
                    <td class="py-1 align-top">
                        <input type="radio" name="group-{{ item.key }}" value="{{ doc.full_path }}" {% if is_default %}checked{% endif %}>
                    </td>
                    <td class="py-1 pr-2 align-top break-all">
                        {{ doc.display_name }}
                        {% if is_default %}<span class="text-xs text-green-700">(conservado por defecto)</span>{% endif %}
                    </td>
                    <td class="py-1 pr-2 align-top break-all text-gray-600 font-mono text-xs" title="{{ doc.full_path }}">
                        {{ doc.full_path | dirname }}
                    </td>
                    <td class="py-1 pr-2 align-top text-right whitespace-nowrap" title="{{ doc.size_bytes }} bytes">
                        {{ doc.size_bytes | file_size }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </fieldset>
    {% endfor %}
    <button type="submit" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Resolver duplicados</button>
</form>
<p id="resolve-result" class="mt-2"></p>
{% elif last_dedup_report %}
<p class="my-2 text-gray-500">No hay duplicados pendientes de revisar en este momento.</p>
{% endif %}

{% if last_dedup_report %}
<p class="my-2 px-3 py-2 rounded bg-blue-50 border border-blue-300 text-blue-900 text-sm">
    La última ejecución de "Buscar duplicados" resolvió
    {{ last_dedup_report.total_exact_duplicates }} duplicado(s) exacto(s) y
    {{ last_dedup_report.total_version_conflicts }} conflicto(s) de versión (conservando por
    defecto el documento más antiguo de cada grupo) el {{ last_dedup_report.timestamp | format_datetime }}{% if last_dedup_report.duration_seconds is not none %}
    (duración: {{ last_dedup_report.duration_seconds | format_duration }}){% endif %}.
    Los ficheros descartados se movieron a la carpeta <code>duplicados/</code> del proyecto.
</p>
{% endif %}

{% if not groups and not last_dedup_report %}
<p>No se detectaron duplicados.</p>
{% endif %}

</div>

</div>

<div id="tab-panel-history" role="tabpanel" aria-labelledby="tab-btn-history" {% if active_tab != 'history' %}hidden{% endif %}>

{% if history_entries %}
<div class="my-3 flex flex-wrap items-center gap-3">
    <div>
        <label for="duplicates-search" class="block text-sm font-medium mb-1">Buscar por nombre o carpeta</label>
        <input type="text" id="duplicates-search" placeholder="Filtra por nombre de archivo o ruta de carpeta…"
               class="border border-gray-300 rounded px-2 py-1.5 w-full max-w-md">
    </div>
    <p class="text-gray-500 text-sm" id="duplicates-count">{{ total_resolved_groups }} grupo(s).</p>
</div>
<p id="duplicates-no-results" class="text-gray-500 my-2" hidden>
    Sin resultados para «<span id="duplicates-no-results-query"></span>».
</p>
{% for entry in history_entries %}
<details class="border border-gray-200 rounded p-3 mb-3 bg-gray-50">
    <summary class="cursor-pointer select-none font-medium text-gray-700">
        {{ entry.report.timestamp | format_datetime }} —
        {{ entry.report.total_exact_duplicates }} duplicado(s) exacto(s),
        {{ entry.report.total_version_conflicts }} conflicto(s) de versión{% if entry.report.duration_seconds is not none %},
        duración: {{ entry.report.duration_seconds | format_duration }}{% endif %}
    </summary>
    <div class="mt-2">
        {% if entry.resolved_groups %}
        {% for item in entry.resolved_groups %}
        <fieldset class="border border-gray-200 rounded p-3 mb-3 bg-white"
                  data-search="{{ (item.members | map(attribute='full_path') | join(' ') | lower) }}">
            <legend class="px-1 font-medium text-gray-600">Grupo {{ loop.index }} ({{ item.group.reason.value }})</legend>
            <table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="text-left text-gray-600">
                        <th class="py-1 pr-2">Archivo</th>
                        <th class="py-1 pr-2">Carpeta original</th>
                        <th class="py-1 pr-2 text-right">Tamaño</th>
                        <th class="py-1 pr-2">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for doc in item.members %}
                    {% set is_kept = doc.full_path == item.kept.full_path %}
                    <tr class="border-t border-gray-200">
                        <td class="py-1 pr-2 align-top break-all">{{ doc.display_name }}</td>
                        <td class="py-1 pr-2 align-top break-all text-gray-600 font-mono text-xs" title="{{ doc.full_path }}">
                            {{ doc.full_path | dirname }}
                        </td>
                        <td class="py-1 pr-2 align-top text-right whitespace-nowrap" title="{{ doc.size_bytes }} bytes">
                            {{ doc.size_bytes | file_size }}
                        </td>
                        <td class="py-1 pr-2 align-top whitespace-nowrap">
                            {% if is_kept %}
                            <span class="text-green-700">Conservado en su carpeta</span>
                            {% else %}
                            <span class="text-gray-500">Movido a duplicados/</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </fieldset>
        {% endfor %}
        {% else %}
        <p class="text-sm text-gray-500">Sin duplicados encontrados en esta ejecución.</p>
        {% endif %}
    </div>
</details>
{% endfor %}
{% else %}
<p class="my-2 text-gray-500">Todavía no hay ninguna deduplicación registrada.</p>
{% endif %}

</div>

<script>
const projectName = {{ project.name | tojson }};

// --- Pestañas (Buscar duplicados / Histórico de deduplicaciones) ---

const tabButtons = { resolve: document.getElementById("tab-btn-resolve"), history: document.getElementById("tab-btn-history") };
const tabPanels = { resolve: document.getElementById("tab-panel-resolve"), history: document.getElementById("tab-panel-history") };

function activateTab(tabName) {
    for (const name of Object.keys(tabButtons)) {
        const isActive = name === tabName;
        tabPanels[name].hidden = !isActive;
        tabButtons[name].setAttribute("aria-selected", isActive ? "true" : "false");
        tabButtons[name].classList.toggle("bg-white", isActive);
        tabButtons[name].classList.toggle("border-gray-300", isActive);
        tabButtons[name].classList.toggle("font-medium", isActive);
        tabButtons[name].classList.toggle("bg-gray-50", !isActive);
        tabButtons[name].classList.toggle("border-transparent", !isActive);
        tabButtons[name].classList.toggle("text-gray-600", !isActive);
    }
}

tabButtons.resolve.addEventListener("click", () => activateTab("resolve"));
tabButtons.history.addEventListener("click", () => activateTab("history"));

// --- Buscar duplicados (accion masiva, aplica las reglas de negocio por defecto) ---

const deduplicateBtn = document.getElementById("deduplicate-btn");
const deduplicateErrorEl = document.getElementById("deduplicate-error");
let form = document.getElementById("resolve-form");

// --- Bloqueo cruzado: "Buscar duplicados" (accion masiva), el formulario de
// resolucion individual (resolve-form) y la pestaña Histórico se bloquean
// entre si mientras cualquiera de las dos operaciones esta en curso, para
// evitar que ambas muevan ficheros del mismo grupo a la vez. El histórico
// tambien se bloquea porque quedaría obsoleto en cuanto termine la operación
// (mismo motivo que "Caché" en Escanear, ver folder_selector.html.j2). ---
let dedupOperationInProgress = false;

function lockDedupControls() {
    dedupOperationInProgress = true;
    tabButtons.history.disabled = true;
    tabButtons.history.title = "Disponible cuando termine la operación en curso";
    deduplicateBtn.disabled = true;
    const resolveSubmitBtn = form ? form.querySelector('button[type="submit"]') : null;
    if (resolveSubmitBtn) resolveSubmitBtn.disabled = true;
}

function unlockDedupControls() {
    dedupOperationInProgress = false;
    tabButtons.history.disabled = false;
    tabButtons.history.removeAttribute("title");
    deduplicateBtn.disabled = false;
    const resolveSubmitBtn = form ? form.querySelector('button[type="submit"]') : null;
    if (resolveSubmitBtn) resolveSubmitBtn.disabled = false;
}

// --- Semáforo de estado (Inicio / Ejecución / Finalización / Error) ---

const dedupSemaforoLights = {
    started: document.getElementById("dedup-light-started"),
    running: document.getElementById("dedup-light-running"),
    completed: document.getElementById("dedup-light-completed"),
};
const dedupSemaforoText = document.getElementById("dedup-semaforo-status-text");
const dedupSemaforoDurationText = document.getElementById("dedup-semaforo-duration-text");
const LIGHT_OFF = "bg-gray-300 border-gray-400";
const LIGHT_ON_AMBER = "bg-amber-400 border-amber-500";
const LIGHT_ON_GREEN = "bg-green-500 border-green-600";
const LIGHT_ON_RED = "bg-red-500 border-red-600";

const DEDUP_PHASE = { IDLE: "idle", STARTED: "started", RUNNING: "running", COMPLETED: "completed", ERROR: "error" };

let dedupSemaforoPhase = DEDUP_PHASE.IDLE; // último estado real alcanzado (no ERROR): IDLE|STARTED|RUNNING|COMPLETED

function paintLight(el, colorClass, pulse) {
    el.className = "inline-block w-3.5 h-3.5 rounded-full border " + colorClass + (pulse ? " animate-pulse" : "");
}

function resetDedupSemaforo() {
    paintLight(dedupSemaforoLights.started, LIGHT_OFF);
    paintLight(dedupSemaforoLights.running, LIGHT_OFF);
    paintLight(dedupSemaforoLights.completed, LIGHT_OFF);
    dedupSemaforoText.textContent = "Sin iniciar";
    dedupSemaforoText.className = "text-sm font-medium text-gray-600 ml-2";
    dedupSemaforoDurationText.textContent = "";
    dedupSemaforoPhase = DEDUP_PHASE.IDLE;
}

function formatDurationClientSide(seconds) {
    const total = Math.round(seconds);
    const minutes = Math.floor(total / 60);
    const secs = total % 60;
    return minutes ? minutes + "m " + secs + "s" : secs + "s";
}

// --- Progreso en vivo (grupos de duplicados detectados/movidos) ---

const dedupGroupProgressContainer = document.getElementById("dedup-group-progress");
const dedupGroupProgressText = document.getElementById("dedup-group-progress-text");
const dedupGroupProgressBar = document.getElementById("dedup-group-progress-bar");
let dedupHasGroupsToResolve = false;

function resetDedupGroupProgress() {
    dedupGroupProgressContainer.hidden = true;
    dedupGroupProgressText.textContent = "";
    dedupGroupProgressBar.max = 1;
    dedupGroupProgressBar.value = 0;
    dedupHasGroupsToResolve = false;
}

function handleDuplicatesFoundEvent(data) {
    if (!data.groups_found) {
        dedupGroupProgressContainer.hidden = false;
        dedupGroupProgressText.textContent = "Sin grupos de duplicados detectados.";
        dedupGroupProgressBar.max = 1;
        dedupGroupProgressBar.value = 1;
        return;
    }
    dedupHasGroupsToResolve = true;
    dedupGroupProgressContainer.hidden = false;
    dedupGroupProgressBar.max = data.groups_found;
    dedupGroupProgressBar.value = 0;
    dedupGroupProgressText.textContent = "Detectado(s) " + data.groups_found + " grupo(s), moviendo…";
}

function handleGroupStartedEvent(data) {
    dedupGroupProgressContainer.hidden = false;
    dedupGroupProgressBar.max = data.total;
    dedupGroupProgressBar.value = data.index - 1;
    dedupGroupProgressText.textContent = "Moviendo grupo " + data.index + "/" + data.total + "…";
}

function handleGroupResolvedEvent() {
    dedupGroupProgressBar.value = Math.min(Number(dedupGroupProgressBar.value) + 1, Number(dedupGroupProgressBar.max));
}

function handleDedupCompletedGroupProgress() {
    if (!dedupHasGroupsToResolve) return;
    const total = Number(dedupGroupProgressBar.max);
    dedupGroupProgressBar.value = total;
    dedupGroupProgressText.textContent = "Completado: " + total + " grupo(s) procesado(s).";
}

function setDedupSemaforo(phase) {
    if (phase === DEDUP_PHASE.ERROR) {
        const failedLight = dedupSemaforoPhase === DEDUP_PHASE.RUNNING ? dedupSemaforoLights.running : dedupSemaforoLights.started;
        paintLight(failedLight, LIGHT_ON_RED);
        dedupSemaforoText.textContent = "Error: la búsqueda de duplicados se ha interrumpido";
        dedupSemaforoText.className = "text-sm font-medium text-red-700 ml-2";
        return;
    }
    dedupSemaforoPhase = phase;
    if (phase === DEDUP_PHASE.STARTED) {
        paintLight(dedupSemaforoLights.started, LIGHT_ON_AMBER);
        dedupSemaforoText.textContent = "Iniciando búsqueda de duplicados…";
        dedupSemaforoText.className = "text-sm font-medium text-amber-700 ml-2";
    } else if (phase === DEDUP_PHASE.RUNNING) {
        paintLight(dedupSemaforoLights.started, LIGHT_ON_AMBER);
        paintLight(dedupSemaforoLights.running, LIGHT_ON_AMBER, true);
        dedupSemaforoText.textContent = "Búsqueda de duplicados en ejecución…";
        dedupSemaforoText.className = "text-sm font-medium text-amber-700 ml-2";
    } else if (phase === DEDUP_PHASE.COMPLETED) {
        paintLight(dedupSemaforoLights.started, LIGHT_ON_AMBER);
        paintLight(dedupSemaforoLights.running, LIGHT_ON_AMBER);
        paintLight(dedupSemaforoLights.completed, LIGHT_ON_GREEN);
        dedupSemaforoText.textContent = "Búsqueda de duplicados finalizada";
        dedupSemaforoText.className = "text-sm font-medium text-green-700 ml-2";
    } else {
        console.error("setDedupSemaforo: fase desconocida", phase);
    }
}

// --- Refresco parcial tras completar una operación: sustituye solo el
// contenido de "Resultado de los duplicados" y del histórico (no toda la
// pagina via window.location.reload()), para que el semáforo en verde
// ("Finalización") siga visible en vez de perderse en una navegación. ---

function extractElementHtml(htmlText, elementId) {
    const parsed = new DOMParser().parseFromString(htmlText, "text/html");
    const el = parsed.getElementById(elementId);
    return el ? el.innerHTML : null;
}

async function refreshDynamicPanels() {
    const response = await fetch(window.location.pathname);
    const html = await response.text();
    const resolveHtml = extractElementHtml(html, "resolve-results-container");
    const historyHtml = extractElementHtml(html, "tab-panel-history");
    if (resolveHtml !== null) {
        document.getElementById("resolve-results-container").innerHTML = resolveHtml;
    }
    if (historyHtml !== null) {
        document.getElementById("tab-panel-history").innerHTML = historyHtml;
    }
    // Los paneles reemplazados traen sus propios <form>/<input> nuevos -- hay
    // que volver a enlazar sus listeners, los del DOM original ya no aplican.
    setupResolveForm();
    setupHistorySearch();
}

const DEDUP_RUNNING_EVENTS = new Set(["duplicates_found", "group_started", "group_resolved"]);

if (deduplicateBtn) {
    deduplicateBtn.addEventListener("click", () => {
        if (dedupOperationInProgress) return;
        deduplicateErrorEl.textContent = "";
        resetDedupSemaforo();
        resetDedupGroupProgress();
        lockDedupControls();

        const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
        const ws = new WebSocket(
            protocol + "//" + window.location.host + "/api/projects/" + encodeURIComponent(projectName) + "/scan/deduplicate"
        );
        let dedupFinished = false;

        ws.onopen = () => {
            setDedupSemaforo(DEDUP_PHASE.STARTED);
        };
        ws.onmessage = async (message) => {
            const dedupEvent = JSON.parse(message.data);
            if (dedupEvent.event === "duplicates_found") {
                handleDuplicatesFoundEvent(dedupEvent.data);
            } else if (dedupEvent.event === "group_started") {
                handleGroupStartedEvent(dedupEvent.data);
            } else if (dedupEvent.event === "group_resolved") {
                handleGroupResolvedEvent();
            }
            if (dedupEvent.event === "completed") {
                dedupFinished = true;
                setDedupSemaforo(DEDUP_PHASE.COMPLETED);
                handleDedupCompletedGroupProgress();
                dedupSemaforoDurationText.textContent = "Duración: " + formatDurationClientSide(dedupEvent.data.duration_seconds || 0);
                unlockDedupControls();
                ws.close();
                // Los grupos resueltos por esta ejecucion deben desaparecer de
                // "pendientes" y pasar a verse en el historico.
                await refreshDynamicPanels();
            } else if (DEDUP_RUNNING_EVENTS.has(dedupEvent.event)) {
                setDedupSemaforo(DEDUP_PHASE.RUNNING);
            }
        };
        ws.onerror = () => {
            deduplicateErrorEl.textContent = "Error de conexión al buscar duplicados.";
            setDedupSemaforo(DEDUP_PHASE.ERROR);
            unlockDedupControls();
        };
        ws.onclose = (closeEvent) => {
            if (!dedupFinished) {
                deduplicateErrorEl.textContent = closeEvent.reason || "No se pudieron buscar duplicados.";
                setDedupSemaforo(DEDUP_PHASE.ERROR);
                unlockDedupControls();
            }
        };
    });
}

// --- Resolver duplicados (formulario de seleccion por grupo) ---

function setupResolveForm() {
    form = document.getElementById("resolve-form");
    if (!form) return;
    form.addEventListener("submit", async (submitEvent) => {
        submitEvent.preventDefault();
        if (dedupOperationInProgress) return;
        lockDedupControls();
        const resolutions = {};
        const formData = new FormData(form);
        for (const [fieldName, value] of formData.entries()) {
            resolutions[fieldName.replace("group-", "")] = value;
        }
        try {
            const response = await fetch(
                "/api/projects/" + encodeURIComponent(projectName) + "/duplicates/resolve",
                {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ resolutions: resolutions }),
                }
            );
            if (response.ok) {
                unlockDedupControls();
                // El grupo resuelto debe desaparecer de "pendientes" y pasar
                // a verse en el histórico.
                await refreshDynamicPanels();
                return;
            }
            const data = await response.json();
            document.getElementById("resolve-result").textContent = data.detail || "Error al resolver duplicados.";
            unlockDedupControls();
        } catch (error) {
            document.getElementById("resolve-result").textContent = "Error al resolver duplicados.";
            unlockDedupControls();
        }
    });
}
setupResolveForm();

// --- Filtro de busqueda del histórico (solo visual: oculta <fieldset> con
// `hidden`). Vive dentro de la pestaña "Histórico de deduplicaciones" y solo
// filtra los fieldset de cada ejecucion del historico -- los grupos pendientes
// de "Buscar duplicados" no tienen buscador propio. ---
function setupHistorySearch() {
    const searchInput = document.getElementById("duplicates-search");
    if (!searchInput) return;
    const fieldsets = Array.from(document.querySelectorAll("#tab-panel-history fieldset[data-search]"));
    const noResults = document.getElementById("duplicates-no-results");
    const noResultsQuery = document.getElementById("duplicates-no-results-query");
    const countEl = document.getElementById("duplicates-count");
    const totalCount = fieldsets.length;

    searchInput.addEventListener("input", () => {
        const rawQuery = searchInput.value.trim();
        const query = rawQuery.toLowerCase();
        let visibleCount = 0;
        for (const fieldset of fieldsets) {
            const matches = query === "" || fieldset.dataset.search.includes(query);
            fieldset.hidden = !matches;
            if (matches) {
                visibleCount += 1;
                // Una coincidencia dentro de una ejecución colapsada (<details>)
                // no se ve aunque el <fieldset> ya no esté `hidden` -- se expande
                // el acordeón que la contiene. No se vuelve a colapsar al borrar
                // la búsqueda.
                if (query !== "") {
                    const detailsAncestor = fieldset.closest("details");
                    if (detailsAncestor) detailsAncestor.open = true;
                }
            }
        }
        if (query !== "" && visibleCount === 0) {
            noResultsQuery.textContent = rawQuery;
            noResults.hidden = false;
        } else {
            noResults.hidden = true;
        }
        countEl.textContent = query === ""
            ? totalCount + " grupo(s)."
            : visibleCount + " de " + totalCount + " grupo(s).";
    });
}
setupHistorySearch();
</script>
{% endblock %}
