{% extends "base.html.j2" %}
{% block title %}doc_organize — Roles{% endblock %}
{% block content %}
<p><a class="text-blue-600 underline" href="/">&larr; Proyectos</a></p>
<h1 class="text-xl font-semibold mb-4">Roles</h1>

<form id="create-role-form" class="my-4 flex gap-2 flex-wrap items-start">
    <label for="role-name" class="sr-only">Nombre del rol</label>
    <input type="text" id="role-name" placeholder="Nombre del rol" required
           class="border border-gray-300 rounded px-2 py-1.5 flex-1 min-w-[200px]">
    <label class="flex items-center gap-1"><input type="checkbox" id="role-is-admin"> Admin (ve todos los proyectos)</label>
    <fieldset id="role-projects-fieldset" class="border border-gray-300 rounded p-3 w-full">
        <legend class="sr-only">Proyectos permitidos</legend>
        {% if projects %}
        {% for project in projects %}
        <label class="flex items-center gap-1 py-0.5"><input type="checkbox" class="role-project-checkbox" value="{{ project.name }}"> {{ project.name }}</label>
        {% endfor %}
        {% else %}
        <span>No hay proyectos todavía.</span>
        {% endif %}
    </fieldset>
    <fieldset id="role-scan-roots-fieldset" class="border border-gray-300 rounded p-3 w-full">
        <legend class="sr-only">Raíces de escaneo permitidas</legend>
        <p class="text-sm mb-2">Raíces de escaneo permitidas (vacío = no puede escanear carpetas externas)</p>
        <ul id="role-scan-roots-list" class="border border-gray-200 rounded divide-y divide-gray-100 mb-2">
            <li class="px-2.5 py-1.5 text-gray-500" id="role-scan-roots-empty">Ninguna todavía.</li>
        </ul>
        <div class="flex gap-2 flex-wrap items-start">
            <label for="role-scan-root-path" class="sr-only">Ruta de la nueva raíz de escaneo</label>
            <input type="text" id="role-scan-root-path" placeholder="Ruta de la carpeta"
                   class="border border-gray-300 rounded px-2 py-1.5 flex-1 min-w-[240px]">
            <button type="button" id="role-scan-root-add-btn" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Guardar carpeta</button>
            <button type="button" id="role-scan-root-browse-btn" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Buscar…</button>
        </div>
        <div id="role-scan-root-browse-panel" hidden class="my-2 border border-gray-300 rounded p-3">
            <p id="role-scan-root-browse-current" class="font-mono text-xs mb-2 break-all"></p>
            <div class="flex gap-2 mb-2 flex-wrap">
                <button type="button" id="role-scan-root-browse-up" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 text-sm">&uarr; Subir</button>
                <button type="button" id="role-scan-root-browse-use" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-blue-100 hover:bg-blue-200 text-sm">Usar esta carpeta</button>
                <button type="button" id="role-scan-root-browse-close" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 text-sm">Cerrar</button>
            </div>
            <ul id="role-scan-root-browse-entries" class="border border-gray-200 rounded divide-y divide-gray-100 max-h-64 overflow-y-auto"></ul>
            <p id="role-scan-root-browse-error" class="text-red-700 my-1 min-h-[1.2em] text-sm"></p>
        </div>
    </fieldset>
    <button type="submit" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Crear rol</button>
</form>
<p id="role-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

<table class="w-full border-collapse mt-4">
    <thead><tr>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Nombre</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Admin</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Proyectos</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300">Raíces de escaneo</th>
        <th class="text-left px-2.5 py-1.5 border-b border-gray-300"></th>
    </tr></thead>
    <tbody>
    {% for role in roles %}
        <tr data-role-id="{{ role.id }}">
            <td class="px-2.5 py-1.5 border-b border-gray-300">{{ role.name }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300">{{ "Sí" if role.is_admin else "No" }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300">{{ role.project_names | join(", ") if role.project_names else "—" }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300">{{ role.allowed_scan_roots | join(", ") if role.allowed_scan_roots else "—" }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300"><button type="button" class="delete-role text-red-700 hover:underline bg-transparent border-0 cursor-pointer p-0" data-role-id="{{ role.id }}">Eliminar</button></td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<script>
async function postJson(url, method, body) {
    const response = await fetch(url, {
        method: method,
        headers: { "Content-Type": "application/json" },
        body: body !== undefined ? JSON.stringify(body) : undefined,
    });
    if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.detail || `Error ${response.status}`);
    }
    return response.status === 204 ? null : response.json();
}

const roleIsAdminCheckbox = document.getElementById("role-is-admin");
const roleProjectsFieldset = document.getElementById("role-projects-fieldset");
const roleScanRootsFieldset = document.getElementById("role-scan-roots-fieldset");

function syncRoleProjectsFieldset() {
    const disabled = roleIsAdminCheckbox.checked;
    roleProjectsFieldset.querySelectorAll(".role-project-checkbox").forEach((checkbox) => {
        checkbox.disabled = disabled;
        if (disabled) checkbox.checked = false;
    });
    roleScanRootsFieldset.querySelectorAll("input, button").forEach((el) => { el.disabled = disabled; });
    if (disabled) scanRoots = [];
    renderScanRootsList();
}
roleIsAdminCheckbox.addEventListener("change", syncRoleProjectsFieldset);

// --- Lista en memoria de raíces de escaneo permitidas (rol aún no existe: no hay API que persista cada ruta) ---

let scanRoots = [];
const scanRootsList = document.getElementById("role-scan-roots-list");
const scanRootsEmpty = document.getElementById("role-scan-roots-empty");

function renderScanRootsList() {
    scanRootsList.querySelectorAll("li[data-path]").forEach((li) => li.remove());
    scanRootsEmpty.hidden = scanRoots.length > 0;
    for (const path of scanRoots) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-2 px-2.5 py-1.5";
        li.dataset.path = path;
        const span = document.createElement("span");
        span.className = "truncate flex-1 min-w-0";
        span.textContent = path;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "shrink-0 text-red-700 underline cursor-pointer text-sm";
        button.textContent = "Eliminar";
        button.addEventListener("click", () => {
            scanRoots = scanRoots.filter((existing) => existing !== path);
            renderScanRootsList();
        });
        li.appendChild(span);
        li.appendChild(button);
        scanRootsList.appendChild(li);
    }
}

function addScanRoot(path) {
    const trimmed = path.trim();
    if (!trimmed || scanRoots.includes(trimmed)) return;
    scanRoots.push(trimmed);
    renderScanRootsList();
}

document.getElementById("role-scan-root-add-btn").addEventListener("click", () => {
    const input = document.getElementById("role-scan-root-path");
    addScanRoot(input.value);
    input.value = "";
});

// --- Explorador de carpetas del servidor ("Buscar…"), mismo patrón que "Carpetas guardadas" ---

const browsePanel = document.getElementById("role-scan-root-browse-panel");
const browseCurrent = document.getElementById("role-scan-root-browse-current");
const browseEntries = document.getElementById("role-scan-root-browse-entries");
const browseError = document.getElementById("role-scan-root-browse-error");
let browseState = { current_path: "", parent_path: null };

function apiError(data, fallback) {
    return (data && data.detail) || fallback;
}

async function browseTo(path) {
    browseError.textContent = "";
    const url = path ? "/api/fs/browse?path=" + encodeURIComponent(path) : "/api/fs/browse";
    const response = await fetch(url);
    const data = await response.json();
    if (!response.ok) {
        browseError.textContent = apiError(data, "No se pudo explorar esa carpeta.");
        return;
    }
    browseState = data;
    browseCurrent.textContent = data.current_path;
    browseEntries.innerHTML = "";
    if (data.entries.length === 0) {
        const li = document.createElement("li");
        li.className = "px-2 py-1 text-gray-500 text-sm";
        li.textContent = "(sin subcarpetas)";
        browseEntries.appendChild(li);
    }
    for (const entryName of data.entries) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "w-full text-left px-2 py-1 cursor-pointer hover:bg-gray-100 text-sm";
        btn.textContent = entryName;
        btn.addEventListener("click", () => {
            const separator = data.current_path.endsWith("/") || data.current_path.endsWith("\\") ? "" : "/";
            browseTo(data.current_path + separator + entryName);
        });
        li.appendChild(btn);
        browseEntries.appendChild(li);
    }
}

document.getElementById("role-scan-root-browse-btn").addEventListener("click", () => {
    browsePanel.hidden = false;
    browseTo(null);
});
document.getElementById("role-scan-root-browse-close").addEventListener("click", () => {
    browsePanel.hidden = true;
});
document.getElementById("role-scan-root-browse-up").addEventListener("click", () => {
    if (browseState.parent_path) browseTo(browseState.parent_path);
});
document.getElementById("role-scan-root-browse-use").addEventListener("click", () => {
    addScanRoot(browseState.current_path);
});

document.getElementById("create-role-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = document.getElementById("role-name").value;
    const is_admin = roleIsAdminCheckbox.checked;
    const project_names = Array.from(roleProjectsFieldset.querySelectorAll(".role-project-checkbox:checked")).map(
        (checkbox) => checkbox.value
    );
    const allowed_scan_roots = scanRoots.slice();
    try {
        await postJson("/api/roles", "POST", { name, is_admin, project_names, allowed_scan_roots });
        window.location.reload();
    } catch (err) {
        document.getElementById("role-error").textContent = err.message;
    }
});

document.querySelectorAll(".delete-role").forEach((button) => {
    button.addEventListener("click", async () => {
        try {
            await postJson(`/api/roles/${button.dataset.roleId}`, "DELETE");
            window.location.reload();
        } catch (err) {
            document.getElementById("role-error").textContent = err.message;
        }
    });
});

syncRoleProjectsFieldset();
</script>
{% endblock %}
