{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% block title %}doc_organize — Escanear: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "scan") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Escanear: {{ project.name }}</h1>

<div role="tablist" class="flex gap-1 border-b border-gray-300 mb-4">
    <button type="button" id="tab-btn-scan" role="tab" aria-selected="{{ 'true' if active_tab != 'cache' else 'false' }}" aria-controls="tab-panel-scan"
            class="page-tab-btn px-3 py-1.5 border border-b-0 rounded-t cursor-pointer {{ 'bg-white border-gray-300 font-medium' if active_tab != 'cache' else 'bg-gray-50 border-transparent text-gray-600 hover:bg-gray-100' }}">Escanear</button>
    <button type="button" id="tab-btn-cache" role="tab" aria-selected="{{ 'true' if active_tab == 'cache' else 'false' }}" aria-controls="tab-panel-cache"
            class="page-tab-btn px-3 py-1.5 border border-b-0 rounded-t cursor-pointer {{ 'bg-white border-gray-300 font-medium' if active_tab == 'cache' else 'bg-gray-50 border-transparent text-gray-600 hover:bg-gray-100' }}">Caché</button>
</div>

<div id="tab-panel-scan" role="tabpanel" aria-labelledby="tab-btn-scan" {% if active_tab == 'cache' %}hidden{% endif %}>

{% if gpu_status.gpu_active %}
<p class="my-2 px-3 py-2 rounded bg-green-50 border border-green-300 text-green-800 text-sm">
    GPU disponible y activa: el OCR acelerado por GPU se puede usar en este escaneo.
</p>
{% elif gpu_status.gpu_support_installed %}
<p class="my-2 px-3 py-2 rounded bg-yellow-50 border border-yellow-300 text-yellow-800 text-sm">
    Hay soporte de GPU instalado, pero no está activo. {{ gpu_status.instructions }}
</p>
{% else %}
<p class="my-2 px-3 py-2 rounded bg-gray-50 border border-gray-300 text-gray-700 text-sm">
    No hay soporte de GPU instalado en este entorno. {{ gpu_status.instructions }}
</p>
{% endif %}

<h2 class="text-lg font-medium mt-4 mb-2">Escanear</h2>
<form id="scan-form" class="my-4">
    <p class="my-2 flex gap-4 flex-wrap">
        <label class="flex items-center gap-1"><input type="checkbox" id="use_ocr"> Usar OCR si hace falta</label>
        <label class="flex items-center gap-1" title="{{ '' if gpu_status.gpu_active else (gpu_status.instructions or '') }}">
            <input type="checkbox" id="use_gpu" {% if not gpu_status.gpu_active %}disabled{% endif %}> OCR con GPU
        </label>
    </p>
    <button type="submit" id="scan-submit-btn" {% if not folders %}disabled{% endif %} class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50">Escanear todas las carpetas guardadas</button>
    {% if not folders %}
    <p class="text-xs text-gray-500 mt-1">Deshabilitado hasta guardar al menos una carpeta (menú {{ project.name }}, Carpetas guardadas).</p>
    {% endif %}
</form>
<p id="scan-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

<h2 class="text-lg font-medium mt-4 mb-2">Resultado del escaneo</h2>
<label for="progress" class="sr-only">Resultado del escaneo</label>
<textarea id="progress" readonly rows="12" class="w-full border border-gray-300 rounded px-2 py-1.5 font-mono text-xs bg-gray-50"></textarea>

</div>

<div id="tab-panel-cache" role="tabpanel" aria-labelledby="tab-btn-cache" {% if active_tab != 'cache' %}hidden{% endif %}>

<p class="mb-3">
    <a class="text-blue-600 underline text-sm" href="/downloads/projects/{{ project.name | urlencode }}/cache-export.xlsx">
        ⬇ Exportar a Excel
    </a>
</p>

{% if cache_total > 0 or cache_q %}
<form method="get" id="cache-filter-form" class="my-3 flex flex-wrap items-end gap-3">
    <input type="hidden" name="tab" value="cache">
    <div>
        <label for="cache-search" class="block text-sm font-medium mb-1">Buscar por nombre o carpeta</label>
        <input type="text" id="cache-search" name="q" value="{{ cache_q or '' }}"
               placeholder="Filtra por nombre de archivo o ruta de carpeta…"
               class="border border-gray-300 rounded px-2 py-1.5 w-full max-w-md">
    </div>
    <div>
        <label for="cache-page-size" class="block text-sm font-medium mb-1">Filas por página</label>
        <select id="cache-page-size" name="page_size" onchange="this.form.requestSubmit()"
                class="border border-gray-300 rounded px-2 py-1.5">
        {% for option in cache_page_size_options %}
            <option value="{{ option }}" {% if option == cache_page_size %}selected{% endif %}>{{ option }}</option>
        {% endfor %}
        </select>
    </div>
    <input type="hidden" name="page" id="cache-page-input" value="1">
    <p class="text-gray-500 text-sm" id="cache-count">
    {% if cache_total == 0 %}
        Sin resultados{% if cache_q %} para «{{ cache_q }}»{% endif %}.
    {% else %}
        Mostrando {{ cache_range_start }}–{{ cache_range_end }} de {{ cache_total }} entradas.
    {% endif %}
    </p>
</form>

{% if cache_entries %}
<div class="overflow-x-auto">
<table class="w-full border-collapse mt-4">
    <thead>
        <tr>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white">Archivo</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white">Carpeta</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-32">Hash</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-24">Estado</th>
        <th class="sticky top-0 z-10 text-left px-2.5 py-1.5 border-b border-gray-300 bg-white whitespace-nowrap w-28">Conversión</th>
    </tr></thead>
    <tbody>
    {% for entry in cache_entries %}
        <tr class="even:bg-gray-50 hover:bg-blue-50">
            <td class="px-2.5 py-1.5 border-b border-gray-300 break-all">{{ entry.file_path | basename | highlight(cache_q) }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 break-all text-gray-600 font-mono text-xs" title="{{ entry.file_path }}">{{ entry.file_path | dirname | highlight(cache_q) }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.sha256_hash[:12] }}…</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.status }}</td>
            <td class="px-2.5 py-1.5 border-b border-gray-300 whitespace-nowrap">{{ entry.conversion_status or "—" }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>

{% if cache_total_pages > 1 %}
<nav aria-label="Paginación" class="flex items-center justify-between mt-3 text-sm">
    {% set base_qs = "tab=cache&q=" + (cache_q or "") | urlencode + "&page_size=" + cache_page_size | string %}
    {% if cache_page > 1 %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ cache_page - 1 }}">« Anterior</a>
    {% else %}
    <span class="text-gray-400">« Anterior</span>
    {% endif %}
    <span class="text-gray-600">Página {{ cache_page }} de {{ cache_total_pages }}</span>
    {% if cache_page < cache_total_pages %}
    <a class="text-blue-600 underline" href="?{{ base_qs }}&page={{ cache_page + 1 }}">Siguiente »</a>
    {% else %}
    <span class="text-gray-400">Siguiente »</span>
    {% endif %}
</nav>
{% endif %}

<p class="mt-3"><a href="#cache-search" class="text-blue-600 underline text-sm">↑ Volver arriba</a></p>
{% endif %}
{% else %}
<p>No hay entradas en caché todavía — ejecuta un escaneo en la pestaña "Escanear".</p>
{% endif %}

</div>

<script>
const projectName = {{ project.name | tojson }};
const libraryBaseUrl = "/api/projects/" + encodeURIComponent(projectName) + "/folders/library";

// --- Pestañas (Escanear / Caché) ---

const tabButtons = { scan: document.getElementById("tab-btn-scan"), cache: document.getElementById("tab-btn-cache") };
const tabPanels = { scan: document.getElementById("tab-panel-scan"), cache: document.getElementById("tab-panel-cache") };

function activateTab(tabName) {
    for (const name of Object.keys(tabButtons)) {
        const isActive = name === tabName;
        tabPanels[name].hidden = !isActive;
        tabButtons[name].setAttribute("aria-selected", isActive ? "true" : "false");
        tabButtons[name].classList.toggle("bg-white", isActive);
        tabButtons[name].classList.toggle("border-gray-300", isActive);
        tabButtons[name].classList.toggle("font-medium", isActive);
        tabButtons[name].classList.toggle("bg-gray-50", !isActive);
        tabButtons[name].classList.toggle("border-transparent", !isActive);
        tabButtons[name].classList.toggle("text-gray-600", !isActive);
    }
}

tabButtons.scan.addEventListener("click", () => activateTab("scan"));
tabButtons.cache.addEventListener("click", () => activateTab("cache"));

// --- Escaneo ---

const form = document.getElementById("scan-form");
const progressBox = document.getElementById("progress");
const errorEl = document.getElementById("scan-error");

function appendProgress(event) {
    progressBox.value += event.event + ": " + JSON.stringify(event.data) + "\n";
    progressBox.scrollTop = progressBox.scrollHeight;
}

form.addEventListener("submit", async (submitEvent) => {
    submitEvent.preventDefault();
    errorEl.textContent = "";
    progressBox.value = "";

    const use_ocr = document.getElementById("use_ocr").checked;
    const use_gpu = document.getElementById("use_gpu").checked;

    const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
    const ws = new WebSocket(
        protocol + "//" + window.location.host + "/api/projects/" + encodeURIComponent(projectName) + "/scan"
    );

    ws.onopen = () => {
        ws.send(JSON.stringify({ use_ocr: use_ocr, use_gpu: use_gpu }));
    };
    ws.onmessage = (message) => {
        const scanEvent = JSON.parse(message.data);
        appendProgress(scanEvent);
        if (scanEvent.event === "completed") {
            ws.close();
        }
    };
    ws.onerror = () => {
        errorEl.textContent = "Error de conexión durante el escaneo.";
    };
});

// --- Búsqueda en Caché (auto-submit con debounce) ---

(function () {
    const searchInput = document.getElementById("cache-search");
    if (!searchInput) return;

    const cacheForm = document.getElementById("cache-filter-form");
    const pageInput = document.getElementById("cache-page-input");
    let debounceTimer = null;

    searchInput.addEventListener("input", () => {
        pageInput.value = "1";
        if (debounceTimer) window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => cacheForm.requestSubmit(), 400);
    });

    if (searchInput.value) {
        searchInput.focus();
        const end = searchInput.value.length;
        searchInput.setSelectionRange(end, end);
    }
})();
</script>
{% endblock %}
