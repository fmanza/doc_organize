{% extends "base.html.j2" %}
{% from "_nav_macros.html.j2" import project_nav %}
{% block title %}doc_organize — Escanear: {{ project.name }}{% endblock %}
{% block sidebar_items %}{{ project_nav(project, "scan") }}{% endblock %}
{% block content %}
<h1 class="text-xl font-semibold mb-4">Escanear: {{ project.name }}</h1>

{% if gpu_status.gpu_active %}
<p class="my-2 px-3 py-2 rounded bg-green-50 border border-green-300 text-green-800 text-sm">
    GPU disponible y activa: el OCR acelerado por GPU se puede usar en este escaneo.
</p>
{% elif gpu_status.gpu_support_installed %}
<p class="my-2 px-3 py-2 rounded bg-yellow-50 border border-yellow-300 text-yellow-800 text-sm">
    Hay soporte de GPU instalado, pero no está activo. {{ gpu_status.instructions }}
</p>
{% else %}
<p class="my-2 px-3 py-2 rounded bg-gray-50 border border-gray-300 text-gray-700 text-sm">
    No hay soporte de GPU instalado en este entorno. {{ gpu_status.instructions }}
</p>
{% endif %}

<h2 class="text-lg font-medium mt-4 mb-2">Carpetas guardadas</h2>
<ul id="folder-list" class="border border-gray-300 rounded divide-y divide-gray-200">
    {% for folder in folders %}
    <li class="flex items-center gap-2 px-2.5 py-1.5" data-path="{{ folder.path }}">
        <label class="flex items-center gap-2 flex-1 min-w-0">
            <input type="checkbox" class="folder-select" value="{{ folder.path }}">
            <span class="truncate">{{ folder.path }}</span>
        </label>
        {% if folder.used %}
        <span class="text-xs text-gray-500 shrink-0">usada</span>
        {% else %}
        <button type="button" class="folder-remove shrink-0 text-red-700 underline cursor-pointer text-sm" data-path="{{ folder.path }}">Eliminar</button>
        {% endif %}
    </li>
    {% else %}
    <li class="px-2.5 py-1.5 text-gray-500">Todavía no hay carpetas guardadas para este proyecto.</li>
    {% endfor %}
</ul>
<p id="folder-list-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

<div class="my-3 flex gap-2 flex-wrap items-start">
    <label for="new-folder-path" class="sr-only">Ruta de la nueva carpeta</label>
    <input type="text" id="new-folder-path" placeholder="Ruta de la carpeta" class="border border-gray-300 rounded px-2 py-1.5 flex-1 min-w-[240px]">
    <button type="button" id="add-folder-btn" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Guardar carpeta</button>
    <button type="button" id="browse-btn" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Buscar…</button>
</div>

<div id="browse-panel" hidden class="my-2 border border-gray-300 rounded p-3">
    <p id="browse-current" class="font-mono text-xs mb-2 break-all"></p>
    <div class="flex gap-2 mb-2 flex-wrap">
        <button type="button" id="browse-up" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 text-sm">&uarr; Subir</button>
        <button type="button" id="browse-use" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-blue-100 hover:bg-blue-200 text-sm">Usar esta carpeta</button>
        <button type="button" id="browse-close" class="px-2 py-1 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200 text-sm">Cerrar</button>
    </div>
    <ul id="browse-entries" class="border border-gray-200 rounded divide-y divide-gray-100 max-h-64 overflow-y-auto"></ul>
    <p id="browse-error" class="text-red-700 my-1 min-h-[1.2em] text-sm"></p>
</div>

<form id="scan-form" class="my-4">
    <p class="my-2 flex gap-4 flex-wrap">
        <label class="flex items-center gap-1"><input type="checkbox" id="deduplicate"> Deduplicar</label>
        <label class="flex items-center gap-1"><input type="checkbox" id="use_ocr"> Usar OCR si hace falta</label>
        <label class="flex items-center gap-1" title="{{ '' if gpu_status.gpu_active else (gpu_status.instructions or '') }}">
            <input type="checkbox" id="use_gpu" {% if not gpu_status.gpu_active %}disabled{% endif %}> OCR con GPU
        </label>
    </p>
    <button type="submit" class="px-3 py-1.5 cursor-pointer border border-gray-300 rounded bg-gray-100 hover:bg-gray-200">Escanear carpetas seleccionadas</button>
</form>
<p id="scan-error" class="text-red-700 my-2 min-h-[1.2em]"></p>

<h2 class="text-lg font-medium mt-4 mb-2">Resultado del escaneo</h2>
<label for="progress" class="sr-only">Resultado del escaneo</label>
<textarea id="progress" readonly rows="12" class="w-full border border-gray-300 rounded px-2 py-1.5 font-mono text-xs bg-gray-50"></textarea>

<script>
const projectName = {{ project.name | tojson }};
const libraryBaseUrl = "/api/projects/" + encodeURIComponent(projectName) + "/folders/library";

function apiError(data, fallback) {
    return (data && data.detail) || fallback;
}

// --- Lista persistente de carpetas ---

async function reloadFolderList() {
    window.location.reload();
}

document.getElementById("add-folder-btn").addEventListener("click", async () => {
    const errorEl = document.getElementById("folder-list-error");
    errorEl.textContent = "";
    const path = document.getElementById("new-folder-path").value.trim();
    if (!path) {
        errorEl.textContent = "Indica una ruta de carpeta.";
        return;
    }
    const response = await fetch(libraryBaseUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ path: path }),
    });
    if (response.ok) {
        await reloadFolderList();
    } else {
        const data = await response.json();
        errorEl.textContent = apiError(data, "No se pudo guardar la carpeta.");
    }
});

document.getElementById("folder-list").addEventListener("click", async (event) => {
    const button = event.target.closest(".folder-remove");
    if (!button) return;
    const errorEl = document.getElementById("folder-list-error");
    errorEl.textContent = "";
    const response = await fetch(libraryBaseUrl, {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ path: button.dataset.path }),
    });
    if (response.ok) {
        await reloadFolderList();
    } else {
        const data = await response.json();
        errorEl.textContent = apiError(data, "No se pudo eliminar la carpeta.");
    }
});

// --- Explorador de carpetas del servidor ("Buscar…") ---

const browsePanel = document.getElementById("browse-panel");
const browseCurrent = document.getElementById("browse-current");
const browseEntries = document.getElementById("browse-entries");
const browseError = document.getElementById("browse-error");
let browseState = { current_path: "", parent_path: null };

async function browseTo(path) {
    browseError.textContent = "";
    const url = path ? "/api/fs/browse?path=" + encodeURIComponent(path) : "/api/fs/browse";
    const response = await fetch(url);
    const data = await response.json();
    if (!response.ok) {
        browseError.textContent = apiError(data, "No se pudo explorar esa carpeta.");
        return;
    }
    browseState = data;
    browseCurrent.textContent = data.current_path;
    browseEntries.innerHTML = "";
    if (data.entries.length === 0) {
        const li = document.createElement("li");
        li.className = "px-2 py-1 text-gray-500 text-sm";
        li.textContent = "(sin subcarpetas)";
        browseEntries.appendChild(li);
    }
    for (const entryName of data.entries) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "w-full text-left px-2 py-1 cursor-pointer hover:bg-gray-100 text-sm";
        btn.textContent = entryName;
        btn.addEventListener("click", () => {
            const separator = data.current_path.endsWith("/") || data.current_path.endsWith("\\") ? "" : "/";
            browseTo(data.current_path + separator + entryName);
        });
        li.appendChild(btn);
        browseEntries.appendChild(li);
    }
}

document.getElementById("browse-btn").addEventListener("click", () => {
    browsePanel.hidden = false;
    browseTo(null);
});
document.getElementById("browse-close").addEventListener("click", () => {
    browsePanel.hidden = true;
});
document.getElementById("browse-up").addEventListener("click", () => {
    if (browseState.parent_path) browseTo(browseState.parent_path);
});
document.getElementById("browse-use").addEventListener("click", async () => {
    browseError.textContent = "";
    const response = await fetch(libraryBaseUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ path: browseState.current_path }),
    });
    if (response.ok) {
        await reloadFolderList();
    } else {
        const data = await response.json();
        browseError.textContent = apiError(data, "No se pudo guardar la carpeta.");
    }
});

// --- Escaneo ---

const form = document.getElementById("scan-form");
const progressBox = document.getElementById("progress");
const errorEl = document.getElementById("scan-error");

function appendProgress(event) {
    progressBox.value += event.event + ": " + JSON.stringify(event.data) + "\n";
    progressBox.scrollTop = progressBox.scrollHeight;
}

form.addEventListener("submit", async (submitEvent) => {
    submitEvent.preventDefault();
    errorEl.textContent = "";
    progressBox.value = "";

    const paths = Array.from(document.querySelectorAll(".folder-select:checked")).map((el) => el.value);
    if (paths.length === 0) {
        errorEl.textContent = "Selecciona al menos una carpeta guardada.";
        return;
    }
    const deduplicate = document.getElementById("deduplicate").checked;
    const use_ocr = document.getElementById("use_ocr").checked;
    const use_gpu = document.getElementById("use_gpu").checked;

    const validateResponse = await fetch(
        "/api/projects/" + encodeURIComponent(projectName) + "/folders/validate",
        {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ paths: paths }),
        }
    );
    const validation = await validateResponse.json();
    if (!validateResponse.ok || !validation.valid) {
        errorEl.textContent = (validation.warnings || []).join("; ") || "Rutas inválidas.";
        return;
    }

    const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
    const ws = new WebSocket(
        protocol + "//" + window.location.host + "/api/projects/" + encodeURIComponent(projectName) + "/scan"
    );

    ws.onopen = () => {
        ws.send(JSON.stringify({ paths: validation.clean_paths, deduplicate: deduplicate, use_ocr: use_ocr, use_gpu: use_gpu }));
    };
    ws.onmessage = (message) => {
        const scanEvent = JSON.parse(message.data);
        appendProgress(scanEvent);
        if (scanEvent.event === "completed") {
            ws.close();
        }
    };
    ws.onerror = () => {
        errorEl.textContent = "Error de conexión durante el escaneo.";
    };
});
</script>
{% endblock %}
