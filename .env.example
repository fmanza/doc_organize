# doc_organize — variables de entorno (copiar a .env y ajustar)

# No existe ninguna variable de entorno de secreto compartido para exponer la
# web app en un host distinto de 127.0.0.1/localhost (el bearer token
# `DOC_ORGANIZE_API_TOKEN` se retiró en la revisión 8 de auth): la
# autenticación es por sesión, usuario+contraseña vía `/login`
# (multi-usuario/multi-tenant). Antes de exponer un host no-loopback, provisiona
# al menos un tenant/usuario con `python -m doc_organize tenant create` /
# `user create` — sin usuarios, ese host queda simplemente inaccesible.

# Ruta de la base de datos de caché (SQLite, REQ-006). Por defecto ./cache.db
DOC_ORGANIZE_CACHE_DB_PATH=./cache.db

# Carpeta de salida de la conversión (REQ-003). Por defecto ./Conversión
DOC_ORGANIZE_OUTPUT_DIR=./Conversión

# Host/puerto de la interfaz web (REQ-007)
DOC_ORGANIZE_WEB_HOST=127.0.0.1
DOC_ORGANIZE_WEB_PORT=8000

# Monitorización de uso/coste de IA (fase 2, extra `ai`, paquete `doc_organize.ai`).
# A diferencia de las variables anteriores de este fichero, estas SÍ se leen
# explícitamente — vía litellm_usage_config_from_env() / github_copilot_usage_config_from_env() —
# nunca de forma implícita al construir los clientes.
DOC_ORGANIZE_LITELLM_BASE_URL=https://litellm.example.com
DOC_ORGANIZE_LITELLM_VIRTUAL_KEY=sk-...
DOC_ORGANIZE_GITHUB_USERNAME=
DOC_ORGANIZE_GITHUB_PAT=
