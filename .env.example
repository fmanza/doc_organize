# doc_organize — variables de entorno (copiar a .env y ajustar)

# No existe ninguna variable de entorno de secreto compartido para exponer la
# web app en un host distinto de 127.0.0.1/localhost (el bearer token
# `DOC_ORGANIZE_API_TOKEN` se retiró en la revisión 8 de auth): la
# autenticación es por sesión, usuario+contraseña vía `/login`
# (multi-usuario/multi-tenant). No hace falta provisionar nada por CLI antes de
# exponer un host no-loopback (rediseño Tenant/Role/User): `AuthStore` crea de
# fábrica el tenant "default" y un usuario admin/admin en el primer arranque —
# pero esa cuenta no puede completar el login en modo no-loopback mientras
# conserve la contraseña de fábrica (cámbiala desde loopback primero). Ver
# docs/functional/access.md.

# CORRECCIÓN (auditoría de parametrización, 2026-09-10): las 4 variables
# DOC_ORGANIZE_CACHE_DB_PATH / DOC_ORGANIZE_OUTPUT_DIR / DOC_ORGANIZE_WEB_HOST /
# DOC_ORGANIZE_WEB_PORT que documentaba este fichero NUNCA se leen del entorno —
# ningún `os.environ`/`os.getenv` las referencia en todo `src/`. Ruta de caché y
# carpeta de salida son, en uso normal (con `--project`), fijas dentro de
# `project.root_path` (`cache.db`, `Conversión/` — ver `core/constants.py`); en
# "uso avanzado sin proyecto" se pasan por flag de CLI (`--cache-file`,
# `--output-dir` de `python -m doc_organize scan`), no por variable de entorno.
# Host/puerto de la web app también son solo flags de CLI: `--host`/`--port` de
# `python -m doc_organize web` (por defecto 127.0.0.1:8000 — ver `main.py`). Se
# retiran de aquí en vez de dejarlas (documentar una env var que no hace nada
# induciría a error); usa los flags de CLI equivalentes.

# Monitorización de uso/coste de IA (fase 2, extra `ai`, paquete `doc_organize.ai`).
# A diferencia de las variables anteriores de este fichero, estas SÍ se leen
# explícitamente — vía litellm_usage_config_from_env() / github_copilot_usage_config_from_env() —
# nunca de forma implícita al construir los clientes.
DOC_ORGANIZE_LITELLM_BASE_URL=https://litellm.example.com
DOC_ORGANIZE_LITELLM_VIRTUAL_KEY=sk-...
DOC_ORGANIZE_GITHUB_USERNAME=
DOC_ORGANIZE_GITHUB_PAT=

# Clasificación de dominios por IA (Sub-fase B, extra `context`, paquete
# `doc_organize.context`/`doc_organize.ai`). Config propia, no comparte
# credenciales con DOC_ORGANIZE_LITELLM_* de arriba (ISP) aunque apunte al mismo
# LiteLLM Proxy — una virtual key por carga de trabajo, para poder atribuir
# presupuesto/rate-limit por separado. Se lee explícitamente vía
# litellm_classification_config_from_env(), solo si se activa el toggle "IA" al
# construir el contexto de un proyecto (opt-in, nunca por defecto). Ver
# docs/guides/litellm_proxy_setup.md para desplegar el proxy con Docker.
DOC_ORGANIZE_LITELLM_CLASSIFICATION_BASE_URL=https://litellm.example.com
DOC_ORGANIZE_LITELLM_CLASSIFICATION_VIRTUAL_KEY=sk-...
# Alias de modelo configurado en el proxy (opcional; por defecto "claude-classifier")
DOC_ORGANIZE_LITELLM_CLASSIFICATION_MODEL=

# Clasificación combinada dominio + tipo de material por IA (Sub-fase B en modo
# manifiesto de taxonomía, `TaxonomyClassificationClient`). Config propia, no
# comparte credenciales con DOC_ORGANIZE_LITELLM_CLASSIFICATION_* de arriba (ISP,
# mismo criterio): resuelve los 2 ejes en una sola llamada combinada, solo se lee
# si el proyecto tiene `taxonomy_manifest.md` y se activa el toggle "IA".
DOC_ORGANIZE_LITELLM_TAXONOMY_CLASSIFICATION_BASE_URL=https://litellm.example.com
DOC_ORGANIZE_LITELLM_TAXONOMY_CLASSIFICATION_VIRTUAL_KEY=sk-...
# Alias de modelo configurado en el proxy (opcional; por defecto "claude-classifier")
DOC_ORGANIZE_LITELLM_TAXONOMY_CLASSIFICATION_MODEL=

# AÑADIDO (auditoría de parametrización, 2026-09-10): faltaba documentar aquí —
# la propia función que las lee (`litellm_taxonomy_manifest_draft_config_from_env()`,
# `ai/taxonomy_manifest_draft_client.py`) ya lo advertía, pero este fichero nunca
# se actualizó al añadir el endpoint de borrador de manifiesto por IA
# (`POST /api/projects/{name}/context/taxonomy-manifest-draft`). Config propia,
# no comparte credenciales con las de clasificación de arriba (ISP): proponer un
# catálogo nuevo a partir de una muestra de documentos es una carga de trabajo
# distinta de clasificar dentro de uno ya cerrado.
DOC_ORGANIZE_LITELLM_TAXONOMY_MANIFEST_DRAFT_BASE_URL=https://litellm.example.com
DOC_ORGANIZE_LITELLM_TAXONOMY_MANIFEST_DRAFT_VIRTUAL_KEY=sk-...
# Alias de modelo configurado en el proxy (opcional; por defecto "claude-classifier")
DOC_ORGANIZE_LITELLM_TAXONOMY_MANIFEST_DRAFT_MODEL=
