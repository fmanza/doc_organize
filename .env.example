# doc_organize 2.0 — variables de entorno que lee la librería (referencia)
#
# doc_organize no carga ningún .env por sí misma: exporta estas variables en el entorno del proceso que la usa (o
# cárgalas tú, p. ej. con python-dotenv). Todas son opcionales. Una aplicación que use la librería (como
# doc_organize_web) puede configurar todo esto por su cuenta, sin variables de entorno.

# --- Registro y fechas --------------------------------------------------------------------------------------------
# Entorno: "development" (DEBUG por defecto) o "production" (INFO).
DOC_ORGANIZE_ENV=
DOC_ORGANIZE_LOG_LEVEL=
# Carpeta de los logs (por defecto, la carpeta de la aplicación del sistema).
DOC_ORGANIZE_LOG_DIR=
# Zona horaria y formato de las fechas que se muestran (por defecto Europe/Madrid y %d/%m/%Y %H:%M:%S).
DOC_ORGANIZE_TIMEZONE=
DOC_ORGANIZE_DATE_FORMAT=

# --- IA (extra `ai`) ----------------------------------------------------------------------------------------------
# Un solo cliente (`LlmClient`) para todas las tareas contra un LiteLLM Proxy, configurado con `settings_from_env()`.
# Sin BASE_URL no hay IA. Ver docs/guides/litellm_proxy_setup.md.
DOC_ORGANIZE_LITELLM_BASE_URL=http://localhost:4000
DOC_ORGANIZE_LITELLM_VIRTUAL_KEY=sk-...
# Modelo de cada tarea (opcional): si no, el alias `doc-organize-<tarea>` del proxy. Tareas: CLASSIFY, ENRICH,
# TAXONOMY_DESIGN, AGENT, EMBED.
# DOC_ORGANIZE_LITELLM_MODEL_CLASSIFY=
# Virtual key propia de una tarea (opcional), para atribuir presupuesto y límites aparte en el proxy.
# DOC_ORGANIZE_LITELLM_VIRTUAL_KEY_CLASSIFY=
#
# Las variables de 1.x (DOC_ORGANIZE_LITELLM_CLASSIFICATION_*, _TAXONOMY_CLASSIFICATION_*, _ENRICHMENT_*,
# _TAXONOMY_MANIFEST_DRAFT_*) ya no se leen: si alguna tiene valor, settings_from_env() falla con su equivalente.
# Ver docs/guides/migracion_2_0.md.

# --- Uso y coste de IA (opcional) ---------------------------------------------------------------------------------
# `litellm_usage_config_from_env()` usa las mismas BASE_URL y VIRTUAL_KEY de arriba.
# `github_copilot_usage_config_from_env()`:
DOC_ORGANIZE_GITHUB_USERNAME=
DOC_ORGANIZE_GITHUB_PAT=

# --- Modelos de Docling (opcional) --------------------------------------------------------------------------------
# Carpeta con los modelos ya descargados (sin red); si no, la caché de Hugging Face (HF_HOME / HF_HUB_CACHE).
# DOCLING_ARTIFACTS_PATH=
